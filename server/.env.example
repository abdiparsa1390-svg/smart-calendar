# Copy this file to server/.env. Never commit server/.env.
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax

# PostgreSQL connection string (local or hosted database).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_calendar

# Generate with: openssl rand -hex 32
# Must be a unique 64-character hex string. Keep it safe; losing it makes encrypted API keys unreadable.
APP_ENCRYPTION_KEY=replace_with_64_hex_characters

# Gmail SMTP for verification emails. Use a NEW app password; do not reuse one posted in chat.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_APP_PASSWORD=replace_with_new_google_app_password
EMAIL_FROM=Smart Calendar <your-address@gmail.com>

# Comma-separated exact allowed browser origins, no trailing slash.
FRONTEND_ORIGINS=http://localhost:5173
