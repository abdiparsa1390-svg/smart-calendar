{
  "name": "smart-calendar",
  "version": "0.1.0",
  "description": "A local-first calendar with an optional AI planning assistant",
  "type": "module",
  "main": "cli.js",
  "bin": {
    "smart-calendar": "./bin/smart-calendar.js"
  },
  "files": [
    "bin/",
    "cli.js",
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "node scripts/build-local.js",
    "prepack": "npm run build:local",
    "preview": "vite preview",
    "dev:api": "npm --prefix server run dev",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run dev:api\""
  },
  "dependencies": {
    "undici": "^6.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "keywords": [
    "calendar",
    "ai",
    "productivity",
    "local-first",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdiparsa1390-svg/smart-calendar.git"
  },
  "homepage": "https://github.com/abdiparsa1390-svg/smart-calendar#readme"
}
