Options -Indexes
RewriteEngine On

# Let the PHP front controller execute without rewriting itself.
RewriteRule ^api/index\.php$ - [L]

# All /api/... requests are handled by the same-origin PHP API.
RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

# Keep real files and directories (Vite assets, icons, etc.) working as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Client-side React routes.
RewriteRule ^ index.html [L]
